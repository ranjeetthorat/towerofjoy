# ─────────────────────────────────────────────────────────────────────────────
# .env.local.example
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Brand & Domain Configuration ─────────────────────────────────────────────
# Override these to rebrand or switch domains without modifying source code.
NEXT_PUBLIC_BRAND_NAME="Tiny Compute"
NEXT_PUBLIC_SITE_URL="https://www.tinycompute.site"
NEXT_PUBLIC_TAGLINE="Technology on autopilot for Indian traders, proprietors, and small business owners."
NEXT_PUBLIC_DESCRIPTION="Whether you want to put your Nifty/BankNifty rules on autopilot, or connect ChatGPT to your daily hisaab-kitaab with websites running tension-free — I build and manage it all for you personally."

# ─── Contact & Social Configuration ───────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL="hello@tinycompute.site"
NEXT_PUBLIC_CONTACT_PHONE="+91 00000 00000"
NEXT_PUBLIC_CONTACT_LOCATION="India"

# Telegram link: Any button or link on the site pointing to Telegram uses this URL.
# You can set it to your personal handle (e.g., https://t.me/yourusername or https://t.me/lintlab)
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/tinycompute"

NEXT_PUBLIC_GITHUB_URL="https://github.com/tinycompute"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/tinycompute"
NEXT_PUBLIC_TWITTER_HANDLE="@tinycompute"
NEXT_PUBLIC_TWITTER_URL="https://twitter.com/tinycompute"

# ─── Optional Build & Version Overrides ───────────────────────────────────────
# By default, next.config.ts resolves git commit SHA and commit count automatically.
# In custom CI environments, you can manually override:
# NEXT_PUBLIC_APP_VERSION="0.1.0"
# NEXT_PUBLIC_BUILD_NUMBER="1"
# NEXT_PUBLIC_COMMIT_SHA="ad6b157"

# ─── Backend & Email Services (Fallback Contact Form) ─────────────────────────
# Email address that receives fallback contact form submissions
CONTACT_TO_EMAIL=you@example.com

# Resend API key (https://resend.com) – used in /src/app/api/contact/route.ts
RESEND_API_KEY=re_xxxxxxxxxxxx
